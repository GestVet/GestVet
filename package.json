{
  "name": "gestvet",
  "private": true,
  "version": "0.1.0",
  "description": "Raíz del monorepositorio. Aloja los hooks de Git compartidos y los atajos de verificación.",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "prepare": "husky",
    "lint:frontend": "pnpm --filter gestvet-frontend exec eslint .",
    "lint:backend": "uv run --directory backend ruff check .",
    "format:backend": "uv run --directory backend ruff format .",
    "arch:backend": "uv run --directory backend lint-imports",
    "test:backend": "uv run --directory backend pytest -q",
    "build:frontend": "pnpm --filter gestvet-frontend build",
    "migrate": "uv run --directory backend alembic upgrade head",
    "seed": "uv run --directory backend python scripts/seed_dev.py",
    "openapi:export": "uv run --directory backend python scripts/export_openapi.py openapi.json",
    "generate:api": "pnpm openapi:export && pnpm --filter gestvet-frontend generate:api",
    "verify": "pnpm lint:backend && pnpm arch:backend && pnpm test:backend && pnpm lint:frontend && pnpm build:frontend"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx}": [
      "pnpm --filter gestvet-frontend exec eslint --max-warnings 0 --no-warn-ignored"
    ],
    "backend/**/*.py": [
      "uv run --directory backend ruff check --force-exclude",
      "uv run --directory backend ruff format --check --force-exclude"
    ]
  }
}
