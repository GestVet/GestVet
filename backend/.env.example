# Copiar a backend/.env y ajustar. Nunca versionar el archivo con valores reales.

APP_NAME=gestvet-api
APP_VERSION=0.1.0
DEBUG=true

# Logs: nivel mínimo (DEBUG, INFO, WARNING o ERROR) y formato. En un despliegue
# conviene LOG_JSON=true, una línea JSON por evento para el recolector.
LOG_LEVEL=INFO
LOG_JSON=false

# PostgreSQL del docker-compose. Para una comprobación rápida sin Docker:
# DATABASE_URL=sqlite+aiosqlite:///./gestvet.db
DATABASE_URL=postgresql+asyncpg://gestvet:gestvet_dev_only@127.0.0.1:5432/gestvet

CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Firma de los tokens de acceso. Mínimo 32 bytes, y con DEBUG=false la
# aplicación se niega a arrancar si conserva este valor de ejemplo.
# Generar uno propio:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambiame-solo-sirve-en-desarrollo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=3600

# Asistente de IA por OpenRouter (https://openrouter.ai/keys). Vacío = apagado.
# El modelo principal y uno de respaldo; se cambian sin tocar código.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_TIMEOUT_SECONDS=45

# Consulta de DNI con Factiliza (proveedor privado). Vacío = sin verificación.
# Para producción conviene el convenio con RENIEC: ver README, "Verificación de DNI".
FACTILIZA_API_KEY=
IDENTITY_REGISTRY_TIMEOUT_SECONDS=10

# Botón "Simular confirmación del banco" del cobro por QR. Sin definir vale lo
# mismo que DEBUG. Nunca en producción: un cliente marcaría pagado su propio cobro.
# QR_SIMULATION_ENABLED=true
